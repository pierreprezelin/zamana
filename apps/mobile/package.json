{
	"name": "@zamana/mobile",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"start": "expo start",
		"update:android": "expo run:android",
		"update:android:clean": "expo prebuild --clean --platform android && expo run:android",
		"update:ios": "expo run:ios",
		"update:ios:clean": "expo prebuild --clean --platform ios && expo run:ios",
		"ts": "tsc --noEmit",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"build:android:dev": "bun i && bunx expo prebuild --clean --platform android && eas build --profile development --platform android --local",
		"build:android:preview": "bun i && bunx expo prebuild --clean --platform android && eas build --profile preview --platform android --local",
		"build:android:release": "bun i && bunx expo prebuild --clean --platform android && eas build --profile production --platform android --local",
		"build:ios:dev": "bun i && bunx expo prebuild --clean --platform ios && eas build --profile development --platform ios --local",
		"build:ios:preview": "bun i && bunx expo prebuild --clean --platform ios && eas build --profile preview --platform ios --local",
		"build:ios:release": "bun i && bunx expo prebuild --clean --platform ios && eas build --profile production --platform ios --local",
		"test:watch": "jest --watchAll"
	},
	"jest": {
		"preset": "jest-expo",
		"setupFiles": [
			"./jest.setup.js"
		],
		"collectCoverageFrom": [
			"src/{features,utils}/**/*.ts"
		],
		"coverageThreshold": {
			"global": {
				"statements": 80,
				"branches": 80,
				"functions": 80,
				"lines": 80
			}
		}
	},
	"dependencies": {
		"@expo/ui": "~58.0.20",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@react-native-vector-icons/ionicons": "^13.1.4",
		"@trpc/client": "11.19.0",
		"@trpc/server": "11.19.0",
		"expo": "^58.0.14",
		"expo-application": "~58.1.2",
		"expo-build-properties": "~58.0.11",
		"expo-constants": "~58.0.12",
		"expo-dev-client": "~58.0.14",
		"expo-device": "~58.0.5",
		"expo-font": "~58.0.8",
		"expo-glass-effect": "~58.0.4",
		"expo-image": "~58.0.15",
		"expo-linking": "~58.0.13",
		"expo-router": "~58.0.23",
		"expo-splash-screen": "~58.0.10",
		"expo-sqlite": "~58.0.13",
		"expo-status-bar": "~58.0.3",
		"expo-system-ui": "~58.0.6",
		"expo-web-browser": "~58.0.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-toast-message": "^2.5.2",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.13.0",
		"uniwind": "^1.12.2",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "30.0.0",
		"@types/react": "~19.3.0",
		"@zamana/api": "workspace:*",
		"babel-plugin-transform-remove-console": "^6.9.4",
		"babel-preset-expo": "~58.0.0",
		"jest": "~30.5.2",
		"jest-expo": "~58.0.11",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3"
	}
}
