{
	"name": "@zamana/mobile",
	"version": "1.0.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"eas-build-pre-install": "test -f assets/fonts/Recoleta-SemiBold.otf || curl -fsSL \"$RECOLETA_OTF_URL\" -o assets/fonts/Recoleta-SemiBold.otf",
		"update:android": "expo run:android",
		"update:android:clean": "expo prebuild --clean --platform android && expo run:android",
		"update:ios": "expo run:ios",
		"update:ios:clean": "expo prebuild --clean --platform ios && expo run:ios",
		"ts": "tsc --noEmit",
		"test": "NODE_OPTIONS=--no-experimental-webstorage jest",
		"test:coverage": "NODE_OPTIONS=--no-experimental-webstorage jest --coverage",
		"build:android:dev": "bun i && bunx expo prebuild --clean --platform android && eas build --profile development --platform android --local",
		"build:android:preview": "bun i && bunx expo prebuild --clean --platform android && eas build --profile preview --platform android --local",
		"build:android:release": "bun i && bunx expo prebuild --clean --platform android && eas build --profile production --platform android --local",
		"build:ios:dev": "bun i && bunx expo prebuild --clean --platform ios && eas build --profile development --platform ios --local",
		"build:ios:preview": "bun i && bunx expo prebuild --clean --platform ios && eas build --profile preview --platform ios --local",
		"build:ios:release": "bun i && bunx expo prebuild --clean --platform ios && eas build --profile production --platform ios --local",
		"test:watch": "NODE_OPTIONS=--no-experimental-webstorage jest --watchAll"
	},
	"jest": {
		"preset": "jest-expo",
		"globalSetup": "./jest.globalSetup.js",
		"setupFiles": [
			"./jest.setup.js"
		],
		"collectCoverageFrom": [
			"src/{features,utils}/**/*.ts"
		],
		"coverageThreshold": {
			"global": {
				"statements": 80,
				"branches": 80,
				"functions": 80,
				"lines": 80
			}
		}
	},
	"dependencies": {
		"@expo/ui": "~58.0.29",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@react-native-vector-icons/ionicons": "^14.0.0",
		"@trpc/client": "11.28.0",
		"@trpc/server": "11.28.0",
		"expo": "~58.0.26",
		"expo-application": "~58.1.2",
		"expo-background-task": "~58.0.13",
		"expo-build-properties": "~58.0.12",
		"expo-constants": "~58.0.16",
		"expo-crypto": "~58.0.8",
		"expo-dev-client": "~58.0.21",
		"expo-file-system": "~58.0.14",
		"expo-font": "~58.0.12",
		"expo-glass-effect": "~58.0.5",
		"expo-haptics": "~58.0.8",
		"expo-image": "~58.0.18",
		"expo-image-manipulator": "~58.0.16",
		"expo-image-picker": "~58.0.10",
		"expo-linking": "~58.0.17",
		"expo-localization": "~58.0.5",
		"expo-location": "~58.0.22",
		"expo-notifications": "~58.1.9",
		"expo-observe": "~58.0.19",
		"expo-router": "~58.0.32",
		"expo-splash-screen": "~58.0.14",
		"expo-sqlite": "~58.0.18",
		"expo-status-bar": "~58.0.5",
		"expo-system-ui": "~58.0.7",
		"expo-task-manager": "~58.0.14",
		"i18next": "^27.2.9",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.88.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-toast-message": "^2.5.2",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.13.0",
		"uniwind": "^1.14.0",
		"zod": "^4.6.5",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "30.0.0",
		"@types/react": "~19.3.3",
		"@zamana/api": "workspace:*",
		"babel-plugin-transform-remove-console": "^6.9.4",
		"babel-preset-expo": "~58.0.26",
		"expo-mcp": "~0.2.1",
		"jest": "~30.5.2",
		"jest-expo": "~58.0.15",
		"tailwind-merge": "^3.7.1",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3"
	}
}
