{
	"name": "@zamana/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "server.ts",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"start": "node server.ts",
		"dev": "nodemon --watch . --watch .env server.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"ts": "tsc"
	},
	"dependencies": {
		"@trpc/server": "^11.28.0",
		"cors": "^2.8.6",
		"dotenv": "^18.0.10",
		"express": "^5.3.0",
		"helmet": "^8.3.0",
		"morgan": "^1.12.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"nodemon": "^3.1.14",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	},
	"nodemonConfig": {
		"execMap": {
			"ts": "node"
		}
	},
	"exports": {
		".": "./routes/index.ts"
	}
}
