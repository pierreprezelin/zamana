{
	"name": "zamana-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "server.ts",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"start": "node server.ts",
		"dev": "nodemon server.ts",
		"typecheck": "tsc",
		"check": "biome check",
		"check:fix": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "bunx lint-staged"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
	},
	"dependencies": {
		"@trpc/server": "^11.19.0",
		"cors": "^2.8.6",
		"dotenv": "^18.0.5",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"morgan": "^1.12.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.6.4",
		"@vitest/coverage-v8": "^5.0.3",
		"lint-staged": "^17.6.0",
		"nodemon": "^3.1.14",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"nodemonConfig": {
		"execMap": {
			"ts": "node"
		}
	}
}
