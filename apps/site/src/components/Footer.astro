---
import { getRelativeLocaleUrl } from "astro:i18n";
import { GITHUB_URL } from "@/constants/stores";
import { type Dictionary, type Locale, privacyPaths } from "@/i18n";

interface Props {
	t: Dictionary;
	locale: Locale;
}

const { t, locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t">
	<div
		class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 py-8 text-sm text-muted-foreground"
	>
		<p>© {year} Pierre Prézelin</p>
		<span aria-hidden="true">·</span>
		<a
			href={`${GITHUB_URL}/blob/main/LICENSE`}
			class="underline-offset-4 hover:text-foreground hover:underline"
		>
			{t.footer.license}
		</a>
		<span aria-hidden="true">·</span>
		<a
			href={getRelativeLocaleUrl(locale, privacyPaths[locale])}
			class="underline-offset-4 hover:text-foreground hover:underline"
		>
			{t.footer.privacy}
		</a>
		<span aria-hidden="true">·</span>
		<a
			href="mailto:contact@pierreprezelin.com"
			class="underline-offset-4 hover:text-foreground hover:underline"
		>
			{t.footer.contact}
		</a>
	</div>
</footer>
