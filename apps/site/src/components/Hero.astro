---
import { Icon } from "astro-icon/components";
import { screens } from "@/assets/screens";
import Illustration from "@/components/Illustration.astro";
import PhoneMockup from "@/components/PhoneMockup.astro";
import Promises from "@/components/Promises.astro";
import StoreButtons from "@/components/StoreButtons.astro";
import type { Dictionary, Locale } from "@/i18n";

interface Props {
	t: Dictionary;
	locale: Locale;
}

const { t, locale } = Astro.props;
---

<section class="relative overflow-hidden bg-primary-tint pt-32 pb-16 lg:pt-40">
	<div
		aria-hidden="true"
		class="absolute -top-24 -right-32 size-[36rem] rounded-[45%_55%_60%_40%/50%_45%_55%_50%] bg-primary-tint-strong"
	>
	</div>
	<div
		aria-hidden="true"
		class="absolute -bottom-40 -left-32 size-[28rem] rounded-[60%_40%_45%_55%/45%_55%_50%_50%] bg-primary-tint-strong/60"
	>
	</div>
	<div
		class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 lg:grid-cols-2"
	>
		<div class="flex flex-col items-start gap-6">
			<p
				class="flex items-center gap-2 rounded-full bg-background px-4 py-2 text-sm font-semibold text-primary"
			>
				<Icon name="ion:leaf" class="size-4" aria-hidden="true" />
				{t.hero.eyebrow}
			</p>
			<h1
				class="font-heading text-5xl leading-tight font-semibold text-balance sm:text-6xl"
			>
				{t.hero.title}
			</h1>
			<p class="max-w-xl text-lg text-pretty text-muted-foreground sm:text-xl">
				{t.hero.description}
			</p>
			<Promises t={t} class="text-primary dark:text-foreground" />
			<StoreButtons t={t} />
		</div>
		<div class="flex items-end justify-center lg:justify-end">
			<PhoneMockup
				src={screens[locale].plant}
				alt={t.hero.screenAlt}
				sizes="(min-width: 40rem) 272px, 160px"
				priority
				class="relative z-10 w-44 shrink-0 sm:w-72"
			/>
			<Illustration
				name="plants"
				priority
				class="relative -ml-10 mb-10 h-64 -scale-x-100 sm:-ml-20 sm:mb-20 sm:h-[28rem]"
			/>
		</div>
	</div>
</section>
