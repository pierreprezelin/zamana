---
import "@/styles/starwind.css";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import {
	defaultLocale,
	getDictionary,
	indexedLocales,
	type Locale,
} from "@/i18n";

interface Props {
	locale: Locale;
	title: string;
	description: string;
	// The page path in each locale, the home page by default
	paths?: Record<Locale, string>;
}

const { locale, title, description, paths } = Astro.props;
const canonicalUrl = getAbsoluteLocaleUrl(locale, paths?.[locale]);
const isIndexed = indexedLocales.includes(locale);
const hasAlternates = indexedLocales.length > 1;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			try {
				const savedTheme = localStorage.getItem("theme");
				const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle(
					"dark",
					savedTheme ? savedTheme === "dark" : prefersDark,
				);
			} catch {}
		</script>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		{!isIndexed && <meta name="robots" content="noindex" />}
		{
			hasAlternates &&
				[...indexedLocales, "x-default"].map((hreflang) => {
					const alternateLocale =
						hreflang === "x-default" ? defaultLocale : (hreflang as Locale);
					return (
						<link
							rel="alternate"
							hreflang={hreflang}
							href={getAbsoluteLocaleUrl(
								alternateLocale,
								paths?.[alternateLocale],
							)}
						/>
					);
				})
		}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Zamana" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={getDictionary(locale).meta.ogLocale} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{
			["Recoleta-SemiBold", "Outfit-Regular"].map((font) => (
				<link
					rel="preload"
					href={`/fonts/${font}.woff2`}
					as="font"
					type="font/woff2"
					crossorigin
				/>
			))
		}
	</head>
	<body>
		<!-- Dark mode illustrations (see .illustration in starwind.css): once grayscale and contrast
		have made the lines black, maps black to #09110E (9, 17, 14 / 255) and keeps white as is -->
		<svg aria-hidden="true" width="0" height="0" class="absolute">
			<filter id="ink-on-dark" color-interpolation-filters="sRGB">
				<feComponentTransfer>
					<feFuncR type="table" tableValues="0.0353 1"></feFuncR>
					<feFuncG type="table" tableValues="0.0667 1"></feFuncG>
					<feFuncB type="table" tableValues="0.0549 1"></feFuncB>
				</feComponentTransfer>
			</filter>
		</svg>
		<slot />
	</body>
</html>
