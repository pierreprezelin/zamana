{
	"name": "zamana-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "src/app.ts",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"start": "node src/app.ts",
		"dev": "node --watch src/app.ts",
		"typecheck": "tsc",
		"check": "biome check",
		"check:fix": "biome check --write",
		"prepare": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "bunx lint-staged"
	},
	"lint-staged": {
		"*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
	},
	"dependencies": {
		"express": "^5.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.4",
		"lint-staged": "^17.6.0",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^7.0.2"
	}
}
